; Engine configuration file.
; THE ROOM REMEMBERS / Torimon — Godot 4.7
config_version=5

[application]

config/name="The Room Remembers"
config/description="You forget. It remembers. — TORIMON"
config/version="1.12.2"
run/main_scene="res://scenes/main/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon/icon_512.png"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
RoomManager="*res://scripts/autoload/room_manager.gd"
MobileInputManager="*res://scripts/autoload/mobile_input_manager.gd"
UiGate="*res://scripts/autoload/ui_gate.gd"
CurseManager="*res://scripts/autoload/curse_manager.gd"
DeathManager="*res://scripts/autoload/death_manager.gd"
CorpseManager="*res://scripts/autoload/corpse_manager.gd"
EchoManager="*res://scripts/autoload/echo_manager.gd"
PuzzleManager="*res://scripts/autoload/puzzle_manager.gd"
DialogueManager="*res://scripts/autoload/dialogue_manager.gd"
DialogueData="*res://scripts/autoload/dialogue_data.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
EndingManager="*res://scripts/autoload/ending_manager.gd"
Palette="*res://scripts/autoload/palette.gd"
UiTheme="*res://scripts/autoload/ui_theme.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
UpdateChecker="*res://scripts/autoload/update_checker.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[gui]

theme/custom="res://themes/torimon_ui.tres"

