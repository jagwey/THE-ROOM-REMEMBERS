texture_path = "res://assets/layers/core_crystal.png"
sprite_scale = 0.35
lines = PackedStringArray("Noroi|Kristal kasada binlerce ışık. Her biri birinin anısı.", "Noroi|Ortada tek bir ışık daha parlak: onun sesi.", "Noroi|Kasanın imza satırı: “Yetkili imza: ███ (kazınmış).”", "Noroi|Tesisi kilitleyen elin kim olduğunu hâlâ okuyamıyorum. Ama Shilda… bütün bunları yıllarca hatırladı.")
