[node name="InitialNotch" type="Area2D" parent="Interactive"]
position = Vector2(800, 288)
script = ExtResource("lore")
lore_id = &"reading_cell_initial_s"
texture_path = "res://assets/props/photograph.png"
sprite_scale = 0.45
lines = PackedStringArray("Noroi|Sayıların altında oyulmuş bir harf var: «S.»", "Noroi|Çentikleri atan el, kendi adının baş harfini de bırakmış.", "Noroi|«S.» harfinin kenarı pürüzsüz. Çok kez parmakla izlenmiş.", "Shilda|Çok kez izledim. Adımı unutmamanın tek yoluydu.", "Noroi|Adın ne? Bu harfin arkasındaki ad.", "Shilda|Adımı en son söylediğimde yanımda biri vardı. Çok oldu.")
repeat_line = "Noroi|«S.» Araştırma Yardımcısı S. burada kalmış."
evidence_title = "Oyuk «S.»"
evidence_body = "Çentiklerin altında tek harf: S. Hücreyi sayan el, adını yalnız baş harfiyle bırakmış."
evidence_section = "notlar"

[node name="DriedFlower" type="Area2D" parent="Interactive"]
position = Vector2(440, 288)
script = ExtResource("lore")
lore_id = &"reading_cell_dried_flower"
texture_path = "res://assets/props/red_flower.png"
sprite_scale = 0.45
lines = PackedStringArray("Noroi|Taşın dibinde kurumuş bir çiçek. Yaprakları hâlâ kırmızı.", "Shilda|Onu ben bıraktım. Gitmeden önce, bir kez.", "Noroi|Neden çiçek? Bir şey söylemek istemiş gibi.", "Shilda|Bir kişiye bırakmıştım. O gelmedi, çiçek bekledi, kurudu.", "Noroi|Gitmeden önce çiçek bırakmak. Veda gibi.", "Shilda|Veda değildi. Dönersem diye bir işaretti.", "Noroi|Döndün mü?", "Shilda|Böyle döndüm, gölge olarak. Çiçeği tutacak elim bile yok.")
repeat_line = "Noroi|Kuru çiçek. Biri buraya sevgiyle gelmiş."
evidence_title = "Kuru Çiçek"
evidence_body = "Hücrenin dibinde kurumuş kırmızı bir çiçek. Çentikleri atan el, kapanışta onu bırakmış."
evidence_section = "notlar"
trust_gate = true
untrusted_lines = PackedStringArray("Noroi|Taşın dibinde kurumuş bir çiçek. Yanına yaklaşırken Shilda sustu.")

