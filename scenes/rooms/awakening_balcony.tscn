[node name="Telescope" type="Area2D" parent="Interactive"]
position = Vector2(300.0, 288.0)
script = ExtResource("lore")
lore_id = &"balcony_view"
texture_path = "res://assets/props/telescope.png"
sprite_scale = 0.9
lines = PackedStringArray("Noroi|Kırık bir dürbün; camın ötesinde zemin yok.", "Noroi|Tesis karanlık bir boşlukta asılı duruyor. Dışarısı yok.", "Noroi|Gözümde bir şimşek çaktı: beyaz önlüklü, yüzü kazınmış biri emir veriyor.", "Shilda|Orası dışarı değil. Burayı tutan boşluk bu.", "Noroi|Sağdaki taş kopmuş. Bedenim basamak olursa sütunlardan karşıya geçerim.")
evidence_title = "Gözlem Balkonu"
evidence_body = "Dürbünün ötesinde tesis, karanlık bir boşlukta asılı duruyor. Dışarısı yok. Gözümde yüzü kazınmış bir yetkili beliriyor."
evidence_section = "izler"
focus_zoom = true

